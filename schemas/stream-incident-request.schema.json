{
  "$defs": {
    "IndicatorAttribution": {
      "additionalProperties": false,
      "properties": {
        "scope": {
          "const": "dominant-tcp-conversation",
          "default": "dominant-tcp-conversation",
          "title": "Scope",
          "type": "string"
        },
        "destination": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Destination",
          "type": "string"
        },
        "destination_port": {
          "exclusiveMinimum": 0,
          "maximum": 65535,
          "title": "Destination Port",
          "type": "integer"
        },
        "observation_count": {
          "exclusiveMinimum": 0,
          "title": "Observation Count",
          "type": "integer"
        },
        "history_known": {
          "title": "History Known",
          "type": "boolean"
        },
        "new_destination": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "New Destination"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "response_authorized": {
          "const": false,
          "default": false,
          "title": "Response Authorized",
          "type": "boolean"
        }
      },
      "required": [
        "destination",
        "destination_port",
        "observation_count",
        "history_known",
        "new_destination",
        "evidence_refs"
      ],
      "title": "IndicatorAttribution",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "feature_schema_version": {
      "const": "features-v4-stream-v1",
      "default": "features-v4-stream-v1",
      "title": "Feature Schema Version",
      "type": "string"
    },
    "context_status": {
      "default": "MISSING",
      "enum": [
        "AVAILABLE",
        "MISSING",
        "STALE",
        "FUTURE",
        "UNKNOWN"
      ],
      "title": "Context Status",
      "type": "string"
    },
    "context_revision": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Context Revision"
    },
    "review_reasons": {
      "items": {
        "type": "string"
      },
      "title": "Review Reasons",
      "type": "array"
    },
    "observation_quality": {
      "default": "PARTIAL",
      "enum": [
        "COMPLETE",
        "PARTIAL"
      ],
      "title": "Observation Quality",
      "type": "string"
    },
    "incident_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Incident Id",
      "type": "string"
    },
    "asset_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Asset Id",
      "type": "string"
    },
    "start_time": {
      "format": "date-time",
      "title": "Start Time",
      "type": "string"
    },
    "end_time": {
      "format": "date-time",
      "title": "End Time",
      "type": "string"
    },
    "family_hint": {
      "default": "unknown",
      "enum": [
        "account",
        "c2",
        "unknown"
      ],
      "title": "Family Hint",
      "type": "string"
    },
    "features": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Features",
      "type": "object"
    },
    "evidence_sources": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Evidence Sources",
      "type": "array"
    },
    "base_severity": {
      "maximum": 15,
      "minimum": 0,
      "title": "Base Severity",
      "type": "integer"
    },
    "raw_refs": {
      "items": {
        "type": "string"
      },
      "title": "Raw Refs",
      "type": "array"
    },
    "indicator": {
      "anyOf": [
        {
          "maxLength": 512,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Indicator"
    },
    "indicator_attribution": {
      "anyOf": [
        {
          "$ref": "#/$defs/IndicatorAttribution"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "incident_id",
    "asset_id",
    "start_time",
    "end_time",
    "evidence_sources",
    "base_severity"
  ],
  "title": "StreamIncidentRequest",
  "type": "object"
}
