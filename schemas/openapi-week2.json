{
  "openapi": "3.1.0",
  "info": {
    "title": "DATN AI SOAR API",
    "summary": "Week 1/2 compatibility services plus Week 3 trained-model inference",
    "version": "3.0.0-week3"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "summary": "Readiness",
        "operationId": "readiness_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          }
        }
      }
    },
    "/predict": {
      "post": {
        "summary": "Predict",
        "operationId": "predict_predict_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IncidentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PredictionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/model/ready": {
      "get": {
        "summary": "Model Readiness",
        "operationId": "model_readiness_model_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelReadinessResponse"
                }
              }
            }
          }
        }
      }
    },
    "/features/wazuh": {
      "post": {
        "summary": "Features From Wazuh",
        "operationId": "features_from_wazuh_features_wazuh_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WazuhAlert"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FeaturePipelineResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/features/wazuh/batch": {
      "post": {
        "summary": "Features From Wazuh Batch",
        "operationId": "features_from_wazuh_batch_features_wazuh_batch_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WazuhAlertBatch"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FeatureBatchResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/features/wazuh/stateful": {
      "post": {
        "summary": "Features From Wazuh Stateful",
        "operationId": "features_from_wazuh_stateful_features_wazuh_stateful_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WazuhAlert"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FeatureStateResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/assets/{asset_id}": {
      "get": {
        "summary": "Asset Context",
        "operationId": "asset_context_assets__asset_id__get",
        "parameters": [
          {
            "name": "asset_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "title": "Asset Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssetContext"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/ti/lookup": {
      "post": {
        "summary": "Threat Intelligence",
        "operationId": "threat_intelligence_ti_lookup_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ThreatLookupRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ThreatIntelligenceResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/risk/evaluate": {
      "post": {
        "summary": "Evaluate Risk",
        "operationId": "evaluate_risk_risk_evaluate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RiskEvaluationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RiskEvaluation"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/orchestrate/mock": {
      "post": {
        "summary": "Orchestrate Mock",
        "operationId": "orchestrate_mock_orchestrate_mock_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IncidentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DecisionRecord"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AssetContext": {
        "properties": {
          "asset_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Asset Id"
          },
          "role": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Role"
          },
          "criticality": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 5.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Criticality"
          },
          "protected": {
            "type": "boolean",
            "title": "Protected"
          },
          "risk_score": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Risk Score"
          },
          "source": {
            "type": "string",
            "enum": [
              "inventory",
              "default"
            ],
            "title": "Source"
          },
          "status": {
            "type": "string",
            "enum": [
              "FOUND",
              "UNKNOWN"
            ],
            "title": "Status"
          },
          "review_required": {
            "type": "boolean",
            "title": "Review Required"
          },
          "context_revision": {
            "type": "string",
            "const": "asset-context-v1",
            "title": "Context Revision",
            "default": "asset-context-v1"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "asset_id",
          "role",
          "protected",
          "source",
          "status",
          "review_required"
        ],
        "title": "AssetContext"
      },
      "AuditRecord": {
        "properties": {
          "incident_id": {
            "type": "string",
            "title": "Incident Id"
          },
          "recorded_at": {
            "type": "string",
            "format": "date-time",
            "title": "Recorded At"
          },
          "workflow_revision": {
            "type": "string",
            "const": "week1-mock-v1",
            "title": "Workflow Revision",
            "default": "week1-mock-v1"
          },
          "outcome": {
            "type": "string",
            "const": "NOTIFIED",
            "title": "Outcome",
            "default": "NOTIFIED"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "incident_id",
          "recorded_at"
        ],
        "title": "AuditRecord"
      },
      "DecisionRecord": {
        "properties": {
          "incident_id": {
            "type": "string",
            "title": "Incident Id"
          },
          "prediction": {
            "$ref": "#/components/schemas/PredictionResponse"
          },
          "ti_context": {
            "$ref": "#/components/schemas/ThreatIntelligenceContext"
          },
          "risk": {
            "$ref": "#/components/schemas/RiskResult"
          },
          "automation_state": {
            "type": "string",
            "const": "SHADOW",
            "title": "Automation State",
            "default": "SHADOW"
          },
          "selected_playbook": {
            "type": "string",
            "const": "create_update_incident_notify",
            "title": "Selected Playbook",
            "default": "create_update_incident_notify"
          },
          "strong_action_allowed": {
            "type": "boolean",
            "const": false,
            "title": "Strong Action Allowed",
            "default": false
          },
          "rationale": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Rationale"
          },
          "audit": {
            "$ref": "#/components/schemas/AuditRecord"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "incident_id",
          "prediction",
          "ti_context",
          "risk",
          "rationale",
          "audit"
        ],
        "title": "DecisionRecord"
      },
      "FeatureBatchResponse": {
        "properties": {
          "feature_schema_version": {
            "type": "string",
            "const": "features-v2",
            "title": "Feature Schema Version",
            "default": "features-v2"
          },
          "input_alert_count": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Input Alert Count"
          },
          "unique_alert_count": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Unique Alert Count"
          },
          "duplicate_alert_count": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Duplicate Alert Count"
          },
          "incidents": {
            "items": {
              "$ref": "#/components/schemas/FeaturePipelineResponse"
            },
            "type": "array",
            "minItems": 1,
            "title": "Incidents"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "input_alert_count",
          "unique_alert_count",
          "duplicate_alert_count",
          "incidents"
        ],
        "title": "FeatureBatchResponse"
      },
      "FeaturePipelineResponse": {
        "properties": {
          "feature_schema_version": {
            "type": "string",
            "const": "features-v2",
            "title": "Feature Schema Version",
            "default": "features-v2"
          },
          "feature_order": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Feature Order"
          },
          "ordered_vector": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Ordered Vector"
          },
          "quality_status": {
            "type": "string",
            "enum": [
              "COMPLETE",
              "PARTIAL"
            ],
            "title": "Quality Status"
          },
          "missing_required_features": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Missing Required Features"
          },
          "structural_zero_features": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Structural Zero Features"
          },
          "incident": {
            "$ref": "#/components/schemas/IncidentRequest"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "feature_order",
          "ordered_vector",
          "quality_status",
          "missing_required_features",
          "structural_zero_features",
          "incident"
        ],
        "title": "FeaturePipelineResponse"
      },
      "FeatureStateResponse": {
        "properties": {
          "ingest_status": {
            "type": "string",
            "enum": [
              "new",
              "duplicate"
            ],
            "title": "Ingest Status"
          },
          "stored_event_count": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Stored Event Count"
          },
          "window_minutes": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Window Minutes"
          },
          "feature": {
            "$ref": "#/components/schemas/FeaturePipelineResponse"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "ingest_status",
          "stored_event_count",
          "window_minutes",
          "feature"
        ],
        "title": "FeatureStateResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status",
            "default": "ok"
          },
          "service": {
            "type": "string",
            "const": "datn-ai-soar-api",
            "title": "Service",
            "default": "datn-ai-soar-api"
          },
          "api_version": {
            "type": "string",
            "const": "3.1.0",
            "title": "Api Version",
            "default": "3.1.0"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "HealthResponse"
      },
      "IncidentRequest": {
        "properties": {
          "incident_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Incident Id"
          },
          "asset_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Asset Id"
          },
          "start_time": {
            "type": "string",
            "format": "date-time",
            "title": "Start Time"
          },
          "end_time": {
            "type": "string",
            "format": "date-time",
            "title": "End Time"
          },
          "family_hint": {
            "type": "string",
            "enum": [
              "account",
              "c2",
              "unknown"
            ],
            "title": "Family Hint",
            "default": "unknown"
          },
          "features": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Features"
          },
          "evidence_sources": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 1,
            "title": "Evidence Sources"
          },
          "base_severity": {
            "type": "integer",
            "maximum": 15.0,
            "minimum": 0.0,
            "title": "Base Severity"
          },
          "raw_refs": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Raw Refs"
          },
          "indicator": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 512
              },
              {
                "type": "null"
              }
            ],
            "title": "Indicator"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "incident_id",
          "asset_id",
          "start_time",
          "end_time",
          "evidence_sources",
          "base_severity"
        ],
        "title": "IncidentRequest"
      },
      "ModelReadinessResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ready",
              "not_configured",
              "invalid"
            ],
            "title": "Status"
          },
          "mode": {
            "type": "string",
            "enum": [
              "trained",
              "mock",
              "unconfigured"
            ],
            "title": "Mode"
          },
          "model_version": {
            "type": "string",
            "title": "Model Version"
          },
          "feature_schema_version": {
            "type": "string",
            "title": "Feature Schema Version"
          },
          "locked_test_status": {
            "type": "string",
            "title": "Locked Test Status"
          },
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "mode",
          "model_version",
          "feature_schema_version",
          "locked_test_status",
          "detail"
        ],
        "title": "ModelReadinessResponse"
      },
      "PredictionResponse": {
        "properties": {
          "model_version": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Model Version",
            "default": "mock-v1"
          },
          "predicted_class": {
            "type": "string",
            "enum": [
              "malicious",
              "benign"
            ],
            "title": "Predicted Class"
          },
          "malicious_probability": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Malicious Probability"
          },
          "family": {
            "type": "string",
            "enum": [
              "account",
              "c2",
              "unknown"
            ],
            "title": "Family"
          },
          "threshold_revision": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Threshold Revision",
            "default": "mock-thr-v1"
          },
          "automation_eligible": {
            "type": "boolean",
            "title": "Automation Eligible",
            "default": false
          },
          "review_required": {
            "type": "boolean",
            "title": "Review Required",
            "default": true
          },
          "inference_mode": {
            "type": "string",
            "enum": [
              "trained",
              "mock"
            ],
            "title": "Inference Mode",
            "default": "mock"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "predicted_class",
          "malicious_probability",
          "family"
        ],
        "title": "PredictionResponse"
      },
      "ReadinessResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ready",
              "degraded"
            ],
            "title": "Status"
          },
          "service": {
            "type": "string",
            "const": "datn-ai-soar-api",
            "title": "Service",
            "default": "datn-ai-soar-api"
          },
          "api_version": {
            "type": "string",
            "const": "3.1.0",
            "title": "Api Version",
            "default": "3.1.0"
          },
          "feature_schema_version": {
            "type": "string",
            "const": "features-v2",
            "title": "Feature Schema Version",
            "default": "features-v2"
          },
          "asset_context_revision": {
            "type": "string",
            "const": "asset-context-v1",
            "title": "Asset Context Revision",
            "default": "asset-context-v1"
          },
          "risk_policy_revision": {
            "type": "string",
            "const": "risk-week2-v1",
            "title": "Risk Policy Revision",
            "default": "risk-week2-v1"
          },
          "ti_policy_revision": {
            "type": "string",
            "const": "ti-week2-v1",
            "title": "Ti Policy Revision",
            "default": "ti-week2-v1"
          },
          "ti_mode": {
            "type": "string",
            "enum": [
              "mock",
              "live",
              "disabled",
              "invalid"
            ],
            "title": "Ti Mode"
          },
          "model_status": {
            "type": "string",
            "enum": [
              "ready",
              "not_configured",
              "invalid"
            ],
            "title": "Model Status"
          },
          "inference_mode": {
            "type": "string",
            "enum": [
              "trained",
              "mock",
              "unconfigured"
            ],
            "title": "Inference Mode"
          },
          "strong_actions_enabled": {
            "type": "boolean",
            "const": false,
            "title": "Strong Actions Enabled",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "ti_mode",
          "model_status",
          "inference_mode"
        ],
        "title": "ReadinessResponse"
      },
      "RiskEvaluation": {
        "properties": {
          "policy_revision": {
            "type": "string",
            "const": "risk-week2-v1",
            "title": "Policy Revision",
            "default": "risk-week2-v1"
          },
          "internal": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Internal"
          },
          "display": {
            "type": "number",
            "maximum": 10.0,
            "minimum": 0.0,
