{
  "$defs": {
    "FeaturePipelineResponse": {
      "additionalProperties": false,
      "properties": {
        "feature_schema_version": {
          "const": "features-v2",
          "default": "features-v2",
          "title": "Feature Schema Version",
          "type": "string"
        },
        "feature_order": {
          "items": {
            "type": "string"
          },
          "title": "Feature Order",
          "type": "array"
        },
        "ordered_vector": {
          "items": {
            "type": "number"
          },
          "title": "Ordered Vector",
          "type": "array"
        },
        "quality_status": {
          "enum": [
            "COMPLETE",
            "PARTIAL"
          ],
          "title": "Quality Status",
          "type": "string"
        },
        "missing_required_features": {
          "items": {
            "type": "string"
          },
          "title": "Missing Required Features",
          "type": "array"
        },
        "structural_zero_features": {
          "items": {
            "type": "string"
          },
          "title": "Structural Zero Features",
          "type": "array"
        },
        "evidence_quality": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Evidence Quality",
          "type": "number"
        },
        "evidence_quality_reasons": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Quality Reasons",
          "type": "array"
        },
        "incident": {
          "$ref": "#/$defs/IncidentRequest"
        }
      },
      "required": [
        "feature_order",
        "ordered_vector",
        "quality_status",
        "missing_required_features",
        "structural_zero_features",
        "evidence_quality",
        "evidence_quality_reasons",
        "incident"
      ],
      "title": "FeaturePipelineResponse",
      "type": "object"
    },
    "IncidentRequest": {
      "additionalProperties": false,
      "properties": {
        "incident_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Incident Id",
          "type": "string"
        },
        "asset_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Asset Id",
          "type": "string"
        },
        "start_time": {
          "format": "date-time",
          "title": "Start Time",
          "type": "string"
        },
        "end_time": {
          "format": "date-time",
          "title": "End Time",
          "type": "string"
        },
        "family_hint": {
          "default": "unknown",
          "enum": [
            "account",
            "c2",
            "unknown"
          ],
          "title": "Family Hint",
          "type": "string"
        },
        "features": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Features",
          "type": "object"
        },
        "evidence_sources": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Sources",
          "type": "array"
        },
        "base_severity": {
          "maximum": 15,
          "minimum": 0,
          "title": "Base Severity",
          "type": "integer"
        },
        "raw_refs": {
          "items": {
            "type": "string"
          },
          "title": "Raw Refs",
          "type": "array"
        },
        "indicator": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Indicator"
        }
      },
      "required": [
        "incident_id",
        "asset_id",
        "start_time",
        "end_time",
        "evidence_sources",
        "base_severity"
      ],
      "title": "IncidentRequest",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "ingest_status": {
      "enum": [
        "new",
        "duplicate"
      ],
      "title": "Ingest Status",
      "type": "string"
    },
    "stored_event_count": {
      "minimum": 1,
      "title": "Stored Event Count",
      "type": "integer"
    },
    "window_minutes": {
      "maximum": 5,
      "minimum": 1,
      "title": "Window Minutes",
      "type": "integer"
    },
    "feature": {
      "$ref": "#/$defs/FeaturePipelineResponse"
    }
  },
  "required": [
    "ingest_status",
    "stored_event_count",
    "window_minutes",
    "feature"
  ],
  "title": "FeatureStateResponse",
  "type": "object"
}
