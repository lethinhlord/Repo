      "minimum": 0,
      "title": "Review Required Total",
      "type": "integer"
    },
    "ood_total": {
      "minimum": 0,
      "title": "Ood Total",
      "type": "integer"
    },
    "ood_by_family": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Ood By Family",
      "type": "object"
    },
    "ood_by_feature": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Ood By Feature",
      "type": "object"
    },
    "feedback_total": {
      "default": 0,
      "minimum": 0,
      "title": "Feedback Total",
