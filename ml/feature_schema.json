{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datn.local/schemas/features-v2.json",
  "title": "DATN behavioral feature vector v2",
  "version": "features-v2",
  "description": "Observed, window-aggregated telemetry only; TI, asset context and labels are excluded.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "failed_login_count",
    "successful_login_count",
    "success_after_fail",
    "unique_target_account_count",
    "unique_source_count",
    "remote_logon_ratio",
    "failure_window_seconds",
    "attempt_rate_per_minute",
    "suspicious_process",
    "periodicity_score",
    "connection_interval_cv",
    "mean_interval_seconds",
    "suricata_alert_count",
    "suricata_severity_score",
    "outbound_connection_count",
    "unique_destination_count",
    "destination_port_count",
    "dns_query_count",
    "dns_unique_query_ratio",
    "flow_total_bytes_log1p"
  ],
  "properties": {
    "failed_login_count": {"type": "number", "minimum": 0, "maximum": 1000000},
    "successful_login_count": {"type": "number", "minimum": 0, "maximum": 1000000},
    "success_after_fail": {"type": "number", "minimum": 0, "maximum": 1},
    "unique_target_account_count": {"type": "number", "minimum": 0, "maximum": 1000000},
    "unique_source_count": {"type": "number", "minimum": 0, "maximum": 1000000},
    "remote_logon_ratio": {"type": "number", "minimum": 0, "maximum": 1},
    "failure_window_seconds": {"type": "number", "minimum": 0, "maximum": 86400},
    "attempt_rate_per_minute": {"type": "number", "minimum": 0, "maximum": 1000000},
    "suspicious_process": {"type": "number", "minimum": 0, "maximum": 1},
    "periodicity_score": {"type": "number", "minimum": 0, "maximum": 1},
    "connection_interval_cv": {"type": "number", "minimum": 0, "maximum": 1000000},
    "mean_interval_seconds": {"type": "number", "minimum": 0, "maximum": 86400},
    "suricata_alert_count": {"type": "number", "minimum": 0, "maximum": 1000000},
    "suricata_severity_score": {"type": "number", "minimum": 0, "maximum": 1},
    "outbound_connection_count": {"type": "number", "minimum": 0, "maximum": 1000000},
    "unique_destination_count": {"type": "number", "minimum": 0, "maximum": 1000000},
    "destination_port_count": {"type": "number", "minimum": 0, "maximum": 65535},
    "dns_query_count": {"type": "number", "minimum": 0, "maximum": 1000000},
    "dns_unique_query_ratio": {"type": "number", "minimum": 0, "maximum": 1},
    "flow_total_bytes_log1p": {"type": "number", "minimum": 0, "maximum": 100}
  },
  "x-feature-order": [
    "failed_login_count",
    "successful_login_count",
    "success_after_fail",
    "unique_target_account_count",
    "unique_source_count",
    "remote_logon_ratio",
    "failure_window_seconds",
    "attempt_rate_per_minute",
    "suspicious_process",
    "periodicity_score",
    "connection_interval_cv",
    "mean_interval_seconds",
    "suricata_alert_count",
    "suricata_severity_score",
    "outbound_connection_count",
    "unique_destination_count",
    "destination_port_count",
    "dns_query_count",
    "dns_unique_query_ratio",
    "flow_total_bytes_log1p"
  ],
  "x-family-features": {
    "account": [
      "failed_login_count",
      "successful_login_count",
      "success_after_fail",
      "unique_target_account_count",
      "unique_source_count",
      "remote_logon_ratio",
      "failure_window_seconds",
      "attempt_rate_per_minute"
    ],
    "c2": [
      "suspicious_process",
      "periodicity_score",
      "connection_interval_cv",
      "mean_interval_seconds",
      "suricata_alert_count",
      "suricata_severity_score",
      "outbound_connection_count",
      "unique_destination_count",
      "destination_port_count",
      "dns_query_count",
      "dns_unique_query_ratio",
      "flow_total_bytes_log1p"
    ]
  },
  "x-excluded-context": [
    "threat_intelligence",
    "asset_criticality",
    "scenario_label",
    "ground_truth",
    "account_identity",
    "exact_destination_identity"
  ]
}
